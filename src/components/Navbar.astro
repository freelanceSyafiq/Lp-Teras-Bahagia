---
import { Image } from "astro:assets";
import logoImg from "../assets/logo-teras-bahagia.png";

const waLink =
  "https://wa.me/6281517258271?text=Halo%20Teras%20Bahagia,%20saya%20ingin%20konsultasi%20KPR%20FLPP";
const igLink = "https://www.instagram.com/terasbahagiaofficial";
const tiktokLink = "https://tiktok.com/@terasbahagiaofficial";
---

<header
  id="beranda"
  class="top-0 sticky z-50 bg-surface-container-lowest border-b border-outline-variant shadow-sm transition-all"
  style="background-color: #ffffff; color-scheme: only light;"
>
  <div
    class="max-w-7xl mx-auto px-4 md:px-8 flex items-center justify-between h-20"
  >
    <!-- Brand Logo & FLPP Pill -->
    <div class="flex items-center gap-3">
      <a
        class="flex items-center gap-2 group py-1"
        href="/"
        aria-label="TerAs Bahagia Beranda"
      >
        <Image
          src={logoImg}
          alt="Logo TerAs Bahagia"
          class="h-14 md:h-16 w-auto object-contain transition-transform duration-200 group-hover:scale-105"
          loading="eager"
          decoding="async"
        />
      </a>
      <span
        class="hidden sm:inline-flex items-center px-2.5 py-0.5 rounded-full text-label-sm font-label-sm bg-secondary-container text-on-secondary-container font-semibold"
      >
        <span class="w-1.5 h-1.5 rounded-full bg-secondary pulse-indicator mr-1.5"></span>
        Subsidi
      </span>
    </div>

    <!-- Navigation Links -->
    <nav class="hidden md:flex items-center space-x-8">
      <a
        class="text-on-surface-variant font-label-md hover:text-primary transition-colors duration-200"
        href="#tipe-unit">Tipe Unit</a
      >
      <a
        class="text-on-surface-variant font-label-md hover:text-primary transition-colors duration-200"
        href="#akses-lokasi">Akses Lokasi</a
      >
      <a
        class="text-on-surface-variant font-label-md hover:text-primary transition-colors duration-200"
        href="#simulasi-cicilan">Simulasi Cicilan</a
      >
      <a
        class="text-on-surface-variant font-label-md hover:text-primary transition-colors duration-200"
        href="#syarat-kpr">Syarat KPR</a
      >
      <a
        class="text-on-surface-variant font-label-md hover:text-primary transition-colors duration-200"
        href="#pengembang">Pengembang</a
      >
    </nav>

    <!-- Trailing Action -->
    <div class="flex items-center gap-3">
      <div class="hidden lg:flex items-center gap-2 mr-1">
        <a
          href={igLink}
          target="_blank"
          rel="noopener noreferrer"
          class="p-2 text-on-surface-variant hover:text-primary hover:bg-surface-container-low rounded-lg transition-colors flex items-center justify-center"
          title="Instagram @terasbahagiaofficial"
          aria-label="Instagram"
        >
          <svg
            class="w-5 h-5"
            fill="none"
            stroke="currentColor"
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="1.8"
            viewBox="0 0 24 24"
          >
            <rect height="20" rx="5" ry="5" width="20" x="2" y="2"></rect>
            <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
            <line x1="17.5" x2="17.51" y1="6.5" y2="6.5"></line>
          </svg>
        </a>
        <a
          href={tiktokLink}
          target="_blank"
          rel="noopener noreferrer"
          class="p-2 text-on-surface-variant hover:text-primary hover:bg-surface-container-low rounded-lg transition-colors flex items-center justify-center"
          title="TikTok @terasbahagiaofficial"
          aria-label="TikTok"
        >
          <svg
            class="w-5 h-5"
            fill="none"
            stroke="currentColor"
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="1.8"
            viewBox="0 0 24 24"
          >
            <path d="M9 12a4 4 0 1 0 4 4V4a5 5 0 0 0 5 5"></path>
          </svg>
        </a>
      </div>

      <a
        class="btn-shimmer hidden sm:inline-flex items-center gap-2 bg-primary-container text-on-primary hover:bg-secondary px-5 py-2.5 rounded-lg text-label-md font-label-md transition-all duration-150 active:scale-95 shadow-sm"
        href={waLink}
        rel="noopener noreferrer"
        target="_blank"
      >
        <svg
          class="w-4 h-4 shrink-0 text-secondary-fixed"
          fill="currentColor"
          viewBox="0 0 24 24"
          aria-hidden="true"
        >
          <path
            d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413Z"
          ></path>
        </svg>
        Konsultasi Marketing
      </a>

      <!-- Mobile Hamburger / Call Button -->
      <button
        id="mobile-menu-btn"
        type="button"
        class="md:hidden p-2 text-primary hover:bg-surface-container-low rounded-lg transition-colors"
        aria-label="Menu Navigasi"
      >
        <span class="material-symbols-outlined text-2xl">menu</span>
      </button>
    </div>
  </div>

  <!-- Mobile Drawer Menu -->
  <div
    id="mobile-nav"
    class="hidden md:hidden border-t border-outline-variant bg-surface-container-lowest px-4 py-4 space-y-3"
  >
    <div class="grid grid-cols-2 gap-2 text-sm font-semibold text-on-surface">
      <a
        href="#tipe-unit"
        class="mobile-link p-2 rounded-lg hover:bg-surface-container-low text-on-surface-variant hover:text-primary"
        >Tipe Unit</a
      >
      <a
        href="#akses-lokasi"
        class="mobile-link p-2 rounded-lg hover:bg-surface-container-low text-on-surface-variant hover:text-primary"
        >Akses Lokasi</a
      >
      <a
        href="#simulasi-cicilan"
        class="mobile-link p-2 rounded-lg hover:bg-surface-container-low text-on-surface-variant hover:text-primary"
        >Simulasi Cicilan</a
      >
      <a
        href="#syarat-kpr"
        class="mobile-link p-2 rounded-lg hover:bg-surface-container-low text-on-surface-variant hover:text-primary"
        >Syarat KPR</a
      >
      <a
        href="#pengembang"
        class="mobile-link p-2 rounded-lg hover:bg-surface-container-low text-on-surface-variant hover:text-primary"
        >Pengembang</a
      >
      <a
        href={igLink}
        target="_blank"
        rel="noopener noreferrer"
        class="p-2 rounded-lg hover:bg-surface-container-low text-on-surface-variant hover:text-primary"
        >Instagram</a
      >
    </div>
    <div class="pt-2 border-t border-outline-variant/40">
      <a
        class="w-full inline-flex items-center justify-center gap-2 bg-primary-container text-on-primary hover:bg-secondary py-3 rounded-lg text-label-md font-label-md shadow-sm"
        href={waLink}
        rel="noopener noreferrer"
        target="_blank"
      >
        <svg
          class="w-4 h-4 shrink-0 text-secondary-fixed"
          fill="currentColor"
          viewBox="0 0 24 24"
          aria-hidden="true"
        >
          <path
            d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413Z"
          ></path>
        </svg>
        Konsultasi Marketing WhatsApp
      </a>
    </div>
  </div>
</header>

<script>
  const btn = document.getElementById("mobile-menu-btn");
  const nav = document.getElementById("mobile-nav");
  if (btn && nav) {
    btn.addEventListener("click", () => {
      nav.classList.toggle("hidden");
    });
    nav.querySelectorAll(".mobile-link").forEach((link) => {
      link.addEventListener("click", () => nav.classList.add("hidden"));
    });
  }
</script>
