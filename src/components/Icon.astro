---
// Custom line-icon set: 24px grid, 1.5 stroke, round caps. Replaces emoji icons.
const paths = {
  check: ['M5 12.5l4.5 4.5L19 7.5'],
  'arrow-right': ['M5 12h14', 'M13 6l6 6-6 6'],
  plus: ['M12 5v14', 'M5 12h14'],
  menu: ['M4 7h16', 'M4 12h16', 'M4 17h16'],
  close: ['M6 6l12 12', 'M18 6L6 18'],
  pin: [
    'M12 21s-6.5-6.2-6.5-11.2a6.5 6.5 0 0 1 13 0C18.5 14.8 12 21 12 21z',
    'M12 12.25a2.25 2.25 0 1 0 0-4.5 2.25 2.25 0 0 0 0 4.5z',
  ],
  // Meja dapur: counter top, cabinet split, faucet
  kitchen: ['M3 11h18', 'M4 11v9h16v-9', 'M12 11v9', 'M14.5 11V6a2 2 0 0 1 4 0v.5'],
  // Tembok bata
  wall: [
    'M3 5h18v14H3z', 'M3 9.67h18', 'M3 14.33h18',
    'M9 5v4.67', 'M15 5v4.67', 'M6 9.67v4.67', 'M12 9.67v4.67', 'M18 9.67v4.67',
    'M9 14.33V19', 'M15 14.33V19',
  ],
  // Mesin air
  drop: ['M12 3.5c3 3.6 5.5 6.6 5.5 9.75a5.5 5.5 0 0 1-11 0C6.5 10.1 9 7.1 12 3.5z', 'M9.5 13.5a2.5 2.5 0 0 0 2.5 2.5'],
  // Sumur bor: pipa vertikal + skala kedalaman
  well: ['M12 3v18', 'M8 3h8', 'M9.5 21h5', 'M5 8h2.5', 'M5 12h2.5', 'M5 16h2.5'],
  bolt: ['M13 3L5 13.5h6L10 21l8-10.5h-6L13 3z'],
  // Rangka baja ringan (truss)
  truss: ['M3 19h18', 'M4 19L12 5l8 14', 'M8 12h8', 'M12 5v14', 'M8 12l4 7 4-7'],
  roof: ['M2.5 11.5L12 4l9.5 7.5', 'M5 9.5V20h14V9.5', 'M8 13h8', 'M8 16.5h8'],
  // Drainase U-ditch (penampang)
  drain: ['M4 6v8a5 5 0 0 0 5 5h6a5 5 0 0 0 5-5V6', 'M8 6v7.5a1.5 1.5 0 0 0 1.5 1.5h5a1.5 1.5 0 0 0 1.5-1.5V6'],
  road: ['M8 3L5 21', 'M16 3l3 18', 'M12 4v3', 'M12 10.5v3', 'M12 17v3'],
} as const;

export type IconName = keyof typeof paths | 'whatsapp';

interface Props {
  name: IconName;
  class?: string;
}

const { name, class: className = 'size-5' } = Astro.props;
---

{name === 'whatsapp' ? (
  <svg viewBox="0 0 24 24" fill="currentColor" class={className} aria-hidden="true">
    <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413Z" />
  </svg>
) : (
  <svg
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.5"
    stroke-linecap="round"
    stroke-linejoin="round"
    class={className}
    aria-hidden="true"
  >
    {paths[name].map((d) => <path d={d} />)}
