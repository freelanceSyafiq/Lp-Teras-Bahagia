---
const floorplanImg = "https://lh3.googleusercontent.com/aida-public/AB6AXuBEvRICXXX1idDV7kGsDicGM9UoIqiQWMO21zdlWVEVt3XFvoV02YPVIy-y2lFRB8lsic1X2rQOmPK6bpb0jIAPhLtnNh1wKHX7uKlUwe0mez4MIoAi8BhqeJkx55-f-pTDBqW9Ilc91dtYfzed4i1a8y63iiCAv5CfGYH6vaYflsbXe-EACh63SqnafbADO21-gMULDsB0IrDeNrDMkXhFUtiRm4Y-ks2eAOqnL2uLIw3cFPMfjmmN8w";
---

<section class="bg-surface-container-low py-20 border-b border-outline-variant/40" id="tipe-unit">
  <div class="max-w-7xl mx-auto px-4 md:px-8">
    
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto mb-14">
      <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-secondary-container text-on-secondary-container font-label-sm text-label-sm mb-3 font-semibold">
        <span class="material-symbols-outlined text-base">architecture</span>
        SPESIFIKASI UNIT
      </div>
      <h2 class="text-headline-lg-mobile md:text-headline-lg font-headline-lg text-primary mb-3">
        Desain Cermat American Style Tipe 30/72
      </h2>
      <p class="text-body-md text-on-surface-variant font-body-md">
        Bangunan 30 m² dengan luas kavling 72 m² (tersedia sisa lahan belakang yang lega untuk dapur & taman keluarga).
      </p>
    </div>

    <!-- 3-Column Bento Grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      
      <!-- Card 1: Layout & Floorplan -->
      <div class="bg-surface-container-lowest rounded-2xl p-6 border border-outline-variant shadow-sm flex flex-col justify-between hover:shadow-md transition-shadow">
        <div>
          <div class="flex items-center justify-between mb-4">
            <span class="px-3 py-1 bg-secondary-container text-on-secondary-container text-label-sm font-label-sm rounded-full font-semibold">
              Denah Tata Ruang
            </span>
            <span class="text-label-sm font-label-sm text-outline font-medium">Luas 30 / 72 m²</span>
          </div>
          <h3 class="text-headline-sm font-headline-sm text-primary mb-2">Pemanfaatan Ruang Efisien</h3>
          <p class="text-body-sm font-body-sm text-on-surface-variant mb-6">Tata letak pencahayaan alami optimal dengan sirkulasi udara silang di kedua sisi.</p>
          
          <!-- Floorplan Visual Representation -->
          <div class="relative bg-surface-container-low rounded-xl p-4 border border-outline-variant/60 mb-6">
            <img
              class="w-full h-44 object-contain rounded-lg"
              alt="Denah arsitektur Tipe 30/72 TerAs Bahagia 2 Kamar Tidur"
              src={floorplanImg}
              loading="lazy"
            />
          </div>

          <!-- Spec Badges -->
          <div class="grid grid-cols-3 gap-2 text-center">
            <div class="p-2.5 rounded-lg bg-surface-container-low border border-outline-variant/40">
              <p class="text-label-sm font-label-sm text-outline">Kamar Tidur</p>
              <p class="text-title-md font-title-md text-primary font-bold">2 KT</p>
            </div>
            <div class="p-2.5 rounded-lg bg-surface-container-low border border-outline-variant/40">
              <p class="text-label-sm font-label-sm text-outline">Kamar Mandi</p>
              <p class="text-title-md font-title-md text-primary font-bold">1 KM</p>
            </div>
            <div class="p-2.5 rounded-lg bg-surface-container-low border border-outline-variant/40">
              <p class="text-label-sm font-label-sm text-outline">Carport</p>
              <p class="text-title-md font-title-md text-secondary font-bold">4,5 Meter</p>
            </div>
          </div>
        </div>

        <div class="mt-6 pt-4 border-t border-outline-variant/40 flex justify-between items-center text-body-sm">
          <span class="text-on-surface-variant">Carport Mobil</span>
          <span class="font-semibold text-primary">1 Mobil + 2 Motor</span>
        </div>
      </div>

      <!-- Card 2: Material Specifications -->
      <div class="bg-surface-container-lowest rounded-2xl p-6 border border-outline-variant shadow-sm flex flex-col justify-between hover:shadow-md transition-shadow">
        <div>
          <div class="flex items-center justify-between mb-4">
            <span class="px-3 py-1 bg-surface-container text-primary text-label-sm font-label-sm rounded-full font-semibold">
              Struktur Bangunan
            </span>
            <span class="text-label-sm font-label-sm text-secondary font-semibold">Standar PUPR</span>
          </div>
          <h3 class="text-headline-sm font-headline-sm text-primary mb-2">Ketahanan Material Premium</h3>
          <p class="text-body-sm font-body-sm text-on-surface-variant mb-6">Dibangun dengan pengawasan ketat memastikan konstruksi awet puluhan tahun.</p>

          <!-- 3 Icon Rows -->
          <div class="space-y-4">
            <div class="flex items-center gap-3.5 p-3 rounded-xl bg-surface-container-low/60 border border-outline-variant/40">
              <div class="w-11 h-11 rounded-full bg-secondary-container flex items-center justify-center shrink-0 text-on-secondary-container">
                <span class="material-symbols-outlined text-xl">view_column</span>
              </div>
              <div>
                <h4 class="text-title-md font-title-md text-on-surface font-semibold">Dinding Bata Ringan</h4>
                <p class="text-body-sm font-body-sm text-on-surface-variant">Kedap suara antar unit, plester, aci, cat berkelas.</p>
              </div>
            </div>

            <div class="flex items-center gap-3.5 p-3 rounded-xl bg-surface-container-low/60 border border-outline-variant/40">
              <div class="w-11 h-11 rounded-full bg-secondary-container flex items-center justify-center shrink-0 text-on-secondary-container">
                <span class="material-symbols-outlined text-xl">roofing</span>
              </div>
              <div>
                <h4 class="text-title-md font-title-md text-on-surface font-semibold">Rangka Baja Ringan & Genteng Beton</h4>
                <p class="text-body-sm font-body-sm text-on-surface-variant">Kuat tahan rayap, tahan panas & cuaca ekstrem.</p>
              </div>
            </div>

            <div class="flex items-center gap-3.5 p-3 rounded-xl bg-surface-container-low/60 border border-outline-variant/40">
              <div class="w-11 h-11 rounded-full bg-secondary-container flex items-center justify-center shrink-0 text-on-secondary-container">
                <span class="material-symbols-outlined text-xl">water</span>
              </div>
              <div>
                <h4 class="text-title-md font-title-md text-on-surface font-semibold">Saluran Drainase Beton U-Ditch</h4>
                <p class="text-body-sm font-body-sm text-on-surface-variant">Sistem drainase tertutup rapi anti-genangan banjir.</p>
              </div>
            </div>
          </div>
        </div>

        <div class="mt-6 pt-4 border-t border-outline-variant/40 flex justify-between items-center text-body-sm">
          <span class="text-on-surface-variant">Garansi Konstruksi</span>
          <span class="font-semibold text-secondary">Masa Retensi Developer</span>
        </div>
      </div>

      <!-- Card 3: Utilitas, Bonus Siap Huni & Legalitas -->
      <div class="bg-surface-container-lowest rounded-2xl p-6 border border-outline-variant shadow-sm flex flex-col justify-between hover:shadow-md transition-shadow">
        <div>
          <div class="flex items-center justify-between mb-4">
            <span class="px-3 py-1 bg-surface-container text-primary text-label-sm font-label-sm rounded-full font-semibold">
              Fasilitas All-In
            </span>
            <span class="text-label-sm font-label-sm text-secondary font-semibold">Bebas Kendala</span>
          </div>
          <h3 class="text-headline-sm font-headline-sm text-primary mb-2">Fasilitas Siap Huni & Legalitas</h3>
          <p class="text-body-sm font-body-sm text-on-surface-variant mb-6">Serah terima unit dengan instalasi lengkap langsung layak huni tanpa repot.</p>

          <!-- 3 Icon Rows -->
          <div class="space-y-4">
            <div class="flex items-center gap-3.5 p-3 rounded-xl bg-surface-container-low/60 border border-outline-variant/40">
              <div class="w-11 h-11 rounded-full bg-secondary-container flex items-center justify-center shrink-0 text-on-secondary-container">
                <span class="material-symbols-outlined text-xl">bolt</span>
              </div>
              <div>
                <h4 class="text-title-md font-title-md text-on-surface font-semibold">Listrik PLN 1.300 VA</h4>
                <p class="text-body-sm font-body-sm text-on-surface-variant">Meteran prabayar resmi siap pakai sejak serah terima.</p>
              </div>
            </div>

            <div class="flex items-center gap-3.5 p-3 rounded-xl bg-surface-container-low/60 border border-outline-variant/40">
              <div class="w-11 h-11 rounded-full bg-secondary-container flex items-center justify-center shrink-0 text-on-secondary-container">
                <span class="material-symbols-outlined text-xl">countertops</span>
              </div>
              <div>
                <h4 class="text-title-md font-title-md text-on-surface font-semibold">Gratis Meja Dapur, Tembok & Sumur 40M</h4>
                <p class="text-body-sm font-body-sm text-on-surface-variant">Mesin air terpasang + tembok belakang keliling tertutup.</p>
              </div>
            </div>

            <div class="flex items-center gap-3.5 p-3 rounded-xl bg-surface-container-low/60 border border-outline-variant/40">
              <div class="w-11 h-11 rounded-full bg-secondary-container flex items-center justify-center shrink-0 text-on-secondary-container">
                <span class="material-symbols-outlined text-xl">verified</span>
              </div>
              <div>
                <h4 class="text-title-md font-title-md text-on-surface font-semibold">Legalitas SHM & PBG Terjamin</h4>
                <p class="text-body-sm font-body-sm text-on-surface-variant">Pecah sertifikat dan izin persetujuan bangunan tuntas.</p>
              </div>
            </div>
          </div>
        </div>

        <div class="mt-6 pt-4 border-t border-outline-variant/40 flex justify-between items-center text-body-sm">
          <span class="text-on-surface-variant">Bank Penyalur Resmi</span>
          <span class="font-semibold text-primary">Bank BNI & Bank BSN</span>
        </div>
      </div>

    </div>

  </div>
</section>
