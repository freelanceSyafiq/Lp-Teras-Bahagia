---
const waLink = "https://wa.me/6281517258271?text=Halo%20Teras%20Bahagia,%20saya%20siap%20amankan%20unit%20subsidi%20Tahap%203";
---

<section class="py-16 bg-surface-container-lowest">
  <div class="max-w-6xl mx-auto px-4 md:px-8">
    
    <!-- Deep Forest Green Banner Box -->
    <div class="bg-primary-container rounded-3xl p-8 md:p-14 text-on-primary text-center shadow-2xl relative overflow-hidden">
      <div class="relative z-10 max-w-3xl mx-auto">
        
        <span class="inline-block px-3.5 py-1 rounded-full bg-secondary-container text-on-secondary-container text-label-sm font-label-sm mb-6 font-bold tracking-wide">
          KUOTA SUBSIDI TERBATAS
        </span>

        <h2 class="text-headline-lg-mobile md:text-headline-lg font-headline-lg text-on-primary mb-4 font-bold">
          Bulan Depan, Bayar Cicilan Rumah Sendiri, Bukan Kontrakan.
        </h2>

        <p class="text-body-lg text-primary-fixed-dim font-body-lg mb-8 leading-relaxed">
          Tipe 30/72 American Style · All-In Rp 2 Juta Terima Kunci · Angsuran Mulai Rp 1.072.300/Bulan Flat.
        </p>

        <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
          <a
            class="w-full sm:w-auto inline-flex items-center justify-center gap-2 bg-surface-container-lowest text-primary hover:bg-surface-container px-8 py-4 rounded-xl text-title-md font-title-md transition-all duration-150 active:scale-95 shadow-lg font-bold"
            href={waLink}
            rel="noopener noreferrer"
            target="_blank"
          >
            <span>Amankan Unit via WhatsApp Sekarang</span>
            <span class="material-symbols-outlined text-base">arrow_forward</span>
          </a>
        </div>

        <!-- Partner Row -->
        <div class="mt-12 pt-8 border-t border-on-primary/20 flex flex-wrap items-center justify-center gap-8 text-on-primary/80 text-body-sm font-body-sm">
          <span>Bank Penyalur Resmi FLPP:</span>
          <span class="font-bold text-on-primary tracking-wider text-base">BANK BNI</span>
          <span>•</span>
          <span class="font-bold text-on-primary tracking-wider text-base">BANK BSN (BANK SYARIAH)</span>
        </div>

      </div>
    </div>

  </div>
</section>
