---
const waLink = "https://wa.me/6281517258271?text=Halo%20Teras%20Bahagia,%20saya%20siap%20amankan%20unit%20subsidi%20Tahap%203";
---

<section class="py-16 bg-surface-container-lowest">
  <div class="max-w-6xl mx-auto px-4 md:px-8">
    
    <!-- Deep Forest Green Banner Box -->
    <div class="reveal card-interactive bg-primary-container rounded-3xl p-8 md:p-14 text-on-primary text-center shadow-2xl relative overflow-hidden">
      <div class="relative z-10 max-w-3xl mx-auto">
        
        <span class="inline-block px-3.5 py-1 rounded-full bg-secondary-container text-on-secondary-container text-label-sm font-label-sm mb-6 font-bold tracking-wide shadow-xs">
          KUOTA SUBSIDI TERBATAS
        </span>

        <h2 class="text-headline-lg-mobile md:text-headline-lg font-headline-lg text-on-primary mb-4 font-bold">
          Bulan Depan, Bayar Cicilan Rumah Sendiri, Bukan Kontrakan.
        </h2>

        <p class="text-body-lg text-primary-fixed-dim font-body-lg mb-8 leading-relaxed">
          Tipe 30/72 American Style · All-In Rp 2 Juta Terima Kunci · Angsuran Mulai Rp 1.072.300/Bulan Flat.
        </p>

        <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
          <a
            class="btn-shimmer w-full sm:w-auto inline-flex items-center justify-center gap-2 bg-surface-container-lowest text-primary hover:bg-surface-container px-8 py-4 rounded-xl text-title-md font-title-md transition-all duration-150 active:scale-95 shadow-lg font-bold"
            href={waLink}
            rel="noopener noreferrer"
            target="_blank"
          >
            <span>Amankan Unit via WhatsApp Sekarang</span>
            <span class="material-symbols-outlined text-base">arrow_forward</span>
          </a>
        </div>

        <!-- Partner Row -->
        <div class="mt-12 pt-8 border-t border-on-primary/20 flex flex-col items-center justify-center gap-3 text-center">
          <p class="text-on-primary/85 text-sm sm:text-base font-medium">
            Bank Penyalur Resmi FLPP:
          </p>
          <div class="flex flex-col sm:flex-row items-center justify-center gap-2.5 sm:gap-4 font-bold text-on-primary tracking-wider text-sm sm:text-base">
            <span class="px-5 py-2 rounded-xl bg-surface-container-lowest/10 backdrop-blur-sm border border-white/15 shadow-xs">
              BANK BNI
            </span>
            <span class="hidden sm:inline text-on-primary/40">•</span>
            <span class="px-5 py-2 rounded-xl bg-surface-container-lowest/10 backdrop-blur-sm border border-white/15 shadow-xs">
              BANK BSN
            </span>
          </div>
        </div>

      </div>
    </div>

  </div>
</section>
