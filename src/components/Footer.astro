---
import {
  ADDRESS,
  MAPS_URL,
  WA_DISPLAY,
  waLink,
  IG_LINK,
  TIKTOK_LINK,
} from "../data/site";
---

<footer
  class="bg-primary border-t border-primary-container text-outline-variant"
>
  <div class="max-w-7xl mx-auto px-4 md:px-8 py-10 md:py-16">
    <!-- 3-Column Top Grid -->
    <div class="grid grid-cols-1 md:grid-cols-12 gap-8 mb-12">
      <!-- Brand & Address (Col 1) -->
      <div class="md:col-span-6 space-y-4">
        <p
          class="text-headline-md font-headline-md font-bold text-surface-container-lowest tracking-tight"
        >
          TERAS BAHAGIA
        </p>
        <p
          class="text-body-sm font-body-sm text-outline-variant max-w-md leading-relaxed"
        >
          Awal Kebahagiaan Keluarga Anda. Kawasan Mandiri ±10 Hektar di
          Sindangheula, Serang. Hunian Subsidi Berkualitas American Style Tipe
          30/72 m² dengan legalitas SHM & PBG resmi.
        </p>

        <!-- Location & Contact Info (Aligned) -->
        <div class="space-y-3 pt-2">
          <!-- Location Link to Google Maps -->
          <a
            href={MAPS_URL}
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-start gap-3 text-body-sm text-outline-variant hover:text-surface-container-lowest transition-colors group"
            title="Buka Lokasi Perumahan TerAs Bahagia di Google Maps"
          >
            <span class="w-5 h-5 flex items-center justify-center shrink-0 mt-0.5 text-secondary-fixed group-hover:scale-110 transition-transform">
              <span class="material-symbols-outlined text-xl leading-none">location_on</span>
            </span>
            <span class="leading-relaxed">
              {ADDRESS}
            </span>
          </a>

          <!-- Phone / WhatsApp Link -->
          <a
            class="flex items-start gap-3 text-body-sm text-outline-variant hover:text-surface-container-lowest transition-colors group"
            href={waLink()}
            target="_blank"
            rel="noopener noreferrer"
            title="Hubungi WhatsApp TerAs Bahagia"
          >
            <span class="w-5 h-5 flex items-center justify-center shrink-0 mt-0.5 text-secondary-fixed group-hover:scale-110 transition-transform">
              <svg
                class="w-4 h-4"
                fill="currentColor"
                viewBox="0 0 24 24"
                aria-hidden="true"
              >
                <path
                  d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413Z"
                ></path>
              </svg>
            </span>
            <span class="leading-relaxed">
              {WA_DISPLAY}
            </span>
          </a>
        </div>
      </div>

      <!-- Links (Col 2) -->
      <div class="md:col-span-3 space-y-3">
        <p
          class="text-title-md font-title-md text-surface-container-lowest font-semibold"
        >
          Tautan Penting
        </p>
        <ul class="space-y-2 text-body-sm">
          <li>
            <a
              class="hover:text-surface-container-lowest text-body-sm font-body-sm transition-colors duration-150"
              href="#syarat-kpr">Syarat KPR FLPP</a
            >
          </li>
          <li>
            <a
              class="hover:text-surface-container-lowest text-body-sm font-body-sm transition-colors duration-150"
              href="#tipe-unit">Sertifikasi SHM / PBG</a
            >
          </li>
          <li>
            <a
              class="hover:text-surface-container-lowest text-body-sm font-body-sm transition-colors duration-150"
              href="#simulasi-cicilan">Mitra Bank Penyalur</a
            >
          </li>
          <li>
            <a
              class="hover:text-surface-container-lowest text-body-sm font-body-sm transition-colors duration-150"
              href="#pengembang">Profil Pengembang (H. Tabrani)</a
            >
          </li>
          <li>
            <a
              class="hover:text-surface-container-lowest text-body-sm transition-colors duration-150 flex items-center gap-1.5"
              href={MAPS_URL}
              target="_blank"
              rel="noopener noreferrer"
            >
              <span>Lokasi di Google Maps</span>
              <span class="text-xs">↗</span>
            </a>
          </li>
        </ul>
      </div>

      <!-- Operational Info & Socials (Col 3) -->
      <div class="md:col-span-3 space-y-3">
        <p
          class="text-title-md font-title-md text-surface-container-lowest font-semibold"
        >
          Pusat Layanan & Media Sosial
        </p>
        <p class="text-body-sm text-outline-variant">
          Kantor Pemasaran Buka Setiap Hari:
        </p>
        <p class="text-body-sm text-surface-container-lowest font-medium">
          Senin - Minggu: 08.30 - 17.30 WIB
        </p>

        <div class="pt-3 border-t border-primary-container space-y-2.5">
          <p
            class="text-label-sm font-label-sm text-surface-container-lowest font-semibold tracking-wide"
          >
            Sosial Media:
          </p>
          <div class="flex flex-col gap-2">
            <!-- Instagram -->
            <a
              class="flex items-center gap-2.5 text-body-sm text-outline-variant hover:text-surface-container-lowest transition-colors"
              href={IG_LINK}
              target="_blank"
              rel="noopener noreferrer"
            >
              <svg
                class="w-4 h-4 shrink-0 text-secondary-fixed"
                fill="none"
                stroke="currentColor"
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="1.8"
                viewBox="0 0 24 24"
              >
                <rect height="20" rx="5" ry="5" width="20" x="2" y="2"></rect>
                <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"
                ></path>
                <line x1="17.5" x2="17.51" y1="6.5" y2="6.5"></line>
              </svg>
              <span>@terasbahagiaofficial</span>
            </a>

            <!-- TikTok -->
            <a
              class="flex items-center gap-2.5 text-body-sm text-outline-variant hover:text-surface-container-lowest transition-colors"
              href={TIKTOK_LINK}
              target="_blank"
              rel="noopener noreferrer"
            >
              <svg
                class="w-4 h-4 shrink-0 text-secondary-fixed"
                fill="none"
                stroke="currentColor"
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="1.8"
                viewBox="0 0 24 24"
              >
                <path d="M9 12a4 4 0 1 0 4 4V4a5 5 0 0 0 5 5"></path>
              </svg>
              <span>@terasbahagiaofficial</span>
            </a>

            <!-- WhatsApp with official WhatsApp icon -->
            <a
              class="flex items-center gap-2.5 text-body-sm text-outline-variant hover:text-surface-container-lowest transition-colors"
              href={waLink()}
              target="_blank"
              rel="noopener noreferrer"
            >
              <svg
                class="w-4 h-4 shrink-0 text-secondary-fixed"
                fill="currentColor"
                viewBox="0 0 24 24"
                aria-hidden="true"
              >
                <path
                  d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413Z"
                ></path>
              </svg>
              <span>+62 815-1725-8271 (WhatsApp)</span>
            </a>
          </div>
        </div>
      </div>
    </div>

    <!-- Copyright Bar -->
    <div
      class="pt-8 border-t border-primary-container text-body-sm font-body-sm text-outline-variant flex flex-col md:flex-row justify-between items-center gap-4 text-center md:text-left"
    >
      <p class="max-w-2xl">© 2026 TerAs Bahagia Serang.</p>
      <div class="flex items-center gap-3 shrink-0">
        <a
          class="hover:text-surface-container-lowest transition-colors"
          href="#beranda">Kebijakan Privasi</a
        >
        <span>•</span>
        <a
          class="hover:text-surface-container-lowest transition-colors"
          href="#syarat-kpr">Syarat KPR FLPP</a
        >
      </div>
    </div>
  </div>
</footer>
