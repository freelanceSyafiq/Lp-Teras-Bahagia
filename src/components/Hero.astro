---
import { MAPS_URL } from "../data/site";
const waBooking =
  "https://wa.me/6281517258271?text=Halo%20Teras%20Bahagia,%20saya%20ingin%20booking%20prioritas%20unit%20subsidi%20Tahap%203";
const waCekUnit =
  "https://wa.me/6281517258271?text=Halo%20Teras%20Bahagia,%20saya%20ingin%20cek%20ketersediaan%20unit%20Tipe%2030/72";
const heroBg = "/images/hero-cluster.jpg";
---

<section
  class="relative bg-primary pb-14 md:pb-20 lg:pb-36 overflow-visible"
  style="background-color: #003820; color-scheme: only light;"
>
  <!-- Background Image with Gradient Overlay -->
  <div class="absolute inset-0 z-0 pointer-events-none">
    <div
      class="w-full h-full bg-cover bg-center md:hero-bg-pos"
      style={`background-image: url('${heroBg}'); background-color: #003820;`}
    >
    </div>
    <div
      class="absolute inset-0 bg-linear-to-b from-primary/90 via-primary/80 to-primary/95 md:bg-linear-to-r md:from-primary/95 md:via-primary/80 md:to-primary/30 lg:to-transparent"
    >
    </div>
  </div>

  <!-- Hero Content Canvas -->
  <div
    class="relative z-10 max-w-7xl mx-auto px-4 md:px-8 pt-10 pb-4 md:pt-16 md:pb-8 lg:pt-20 lg:pb-28"
  >
    <div class="max-w-3xl">
      <!-- Pill Badge -->
      <div
        class="reveal inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-secondary-container text-on-secondary-fixed text-label-sm font-bold mb-4 shadow-xs"
      >
        <span class="w-2 h-2 rounded-full bg-secondary pulse-indicator"></span>
        <span>Awal Kebahagiaan Keluarga Anda</span>
      </div>

      <!-- Main Headline -->
      <h1
        class="reveal delay-75 text-display-hero-mobile md:text-display-hero font-display-hero text-on-primary font-extrabold mb-5"
      >
        Berhenti Bayar Kontrakan. <span class="block">Miliki Rumah Subsidi Setara Komersil di Serang</span>
      </h1>

      <!-- Subheadline with Real Data -->
      <p
        class="reveal delay-150 text-body-lg text-primary-fixed-dim font-body-lg mb-8 max-w-2xl leading-relaxed"
      >
        Tipe 30/72 berfasad Modern American Style dengan tanah lega di
        Sindangheula. Cicilan Rp 1.072.300/bulan flat, <strong
          class="font-bold text-on-primary"
          >All-In cukup Rp 2 Juta sampai terima kunci.</strong
        >
      </p>

      <!-- Action Buttons -->
      <div
        class="reveal delay-200 flex flex-col sm:flex-row items-stretch sm:items-center gap-3 sm:gap-4"
      >
        <a
          class="btn-shimmer inline-flex items-center justify-center gap-2 bg-secondary text-on-secondary hover:bg-primary-container px-6 py-3.5 rounded-lg text-label-md font-label-md transition-all duration-150 active:scale-95 shadow-md font-semibold text-center"
          href={waBooking}
          rel="noopener noreferrer"
          target="_blank"
        >
          <span>Booking Prioritas Sekarang</span>
          <span class="material-symbols-outlined text-lg">arrow_forward</span>
        </a>

        <a
          class="inline-flex items-center justify-center gap-2 border border-outline-variant/60 text-on-primary hover:bg-surface-container-lowest/10 px-5 py-3.5 rounded-lg text-label-md font-label-md transition-colors font-medium text-center active:scale-95"
          href="#simulasi-cicilan"
        >
          <span class="material-symbols-outlined text-lg">calculate</span>
          <span>Hitung Angsuran</span>
        </a>
      </div>
    </div>
  </div>

  <!-- Overlapping Floating Estimator Widget -->
  <div
    class="reveal delay-200 relative z-20 max-w-6xl mx-auto px-4 mt-8 md:mt-12 lg:mt-0 lg:absolute lg:-bottom-16 lg:left-0 lg:right-0"
  >
    <div
      class="card-interactive bg-surface-container-lowest rounded-2xl shadow-xl border border-outline-variant p-5 md:p-6 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 items-center"
    >
      <!-- Col 1: Lokasi (Clickable to Google Maps) -->
      <a
        href={MAPS_URL}
        target="_blank"
        rel="noopener noreferrer"
        class="flex gap-3.5 border-b sm:border-b-0 pb-4 sm:pb-0 sm:border-r border-outline-variant/50 pr-2 items-center group cursor-pointer hover:opacity-95 transition-opacity"
        title="Buka Titik Lokasi di Google Maps (Buka Tab Baru)"
      >
        <div
          class="w-10 h-10 rounded-full bg-secondary-container flex items-center justify-center shrink-0 text-on-secondary-container group-hover:scale-105 transition-transform"
        >
          <span class="material-symbols-outlined text-xl">location_on</span>
        </div>
        <div>
          <p class="text-label-sm font-label-sm text-outline">LOKASI PROYEK</p>
          <p
            class="text-title-md font-title-md text-on-surface font-semibold group-hover:text-secondary transition-colors flex items-center gap-1"
          >
            <span>Sindangheula, Pabuaran, Serang</span>
            <span class="text-xs text-secondary opacity-70">↗</span>
          </p>
          <p class="text-body-sm font-body-sm text-secondary font-bold">
            10 Menit ke KP3B & Kampus
          </p>
        </div>
      </a>

      <!-- Col 2: Tipe -->
      <div
        class="flex gap-3.5 border-b sm:border-b-0 pb-4 sm:pb-0 lg:border-r border-outline-variant/50 pr-2 items-center"
      >
        <div
          class="w-10 h-10 rounded-full bg-secondary-container flex items-center justify-center shrink-0 text-on-secondary-container"
        >
          <span class="material-symbols-outlined text-xl">home</span>
        </div>
        <div>
          <p class="text-label-sm font-label-sm text-outline">TIPE & KAVLING</p>
          <p class="text-title-md font-title-md text-on-surface font-semibold">
            American Style 30/72 m²
          </p>
          <p class="text-body-sm font-body-sm text-secondary font-bold">
            2 Kamar Tidur + Lahan Belakang
          </p>
        </div>
      </div>

      <!-- Col 3: Biaya -->
      <div
        class="flex gap-3.5 border-b sm:border-b-0 pb-4 sm:pb-0 sm:border-r border-outline-variant/50 pr-2 items-center"
      >
        <div
          class="w-10 h-10 rounded-full bg-secondary-container flex items-center justify-center shrink-0 text-on-secondary-container"
        >
          <span class="material-symbols-outlined text-xl">payments</span>
        </div>
        <div>
          <p class="text-label-sm font-label-sm text-outline">
            ALL-IN TERIMA KUNCI
          </p>
          <p class="text-title-md font-title-md text-primary font-bold">
            All-In Rp 2 Juta
          </p>
          <p class="text-body-sm font-body-sm text-secondary font-bold">
            DP 250 Rb · Cicilan 1,07 Jt/bln (Flat 5%)
          </p>
        </div>
      </div>

      <!-- Col 4: Action Button -->
      <div class="w-full flex items-center">
        <a
          class="w-full inline-flex items-center justify-center gap-2 bg-secondary text-on-secondary hover:bg-primary-container px-5 py-3.5 rounded-lg text-label-md font-label-md transition-all duration-150 active:scale-95 shadow-sm text-center font-semibold"
          href={waCekUnit}
          rel="noopener noreferrer"
          target="_blank"
        >
          <svg
            class="w-4 h-4 shrink-0 text-on-secondary"
            fill="currentColor"
            viewBox="0 0 24 24"
            aria-hidden="true"
          >
            <path
              d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413Z"
            ></path>
          </svg>
          <span>Cek Unit via WhatsApp</span>
          <span class="material-symbols-outlined text-base">arrow_forward</span>
        </a>
      </div>
    </div>
  </div>
</section>
