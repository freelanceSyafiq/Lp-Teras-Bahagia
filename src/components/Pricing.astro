---
const waTenor10 = "https://wa.me/6281517258271?text=Halo%20Teras%20Bahagia,%20saya%20tertarik%20simulasi%20tenor%2010%20tahun%20(Rp%201.730.400)";
const waTenor15 = "https://wa.me/6281517258271?text=Halo%20Teras%20Bahagia,%20saya%20tertarik%20simulasi%20tenor%2015%20tahun%20(Rp%201.287.300)";
const waTenor20 = "https://wa.me/6281517258271?text=Halo%20Teras%20Bahagia,%20saya%20ingin%20ambil%20tenor%2020%20tahun%20Rp%201.072.300";
---

<section class="bg-surface-container-low py-20 border-b border-outline-variant/40" id="simulasi-cicilan">
  <div class="max-w-7xl mx-auto px-4 md:px-8">
    
    <!-- Section Header -->
    <div class="reveal text-center max-w-3xl mx-auto mb-14">
      <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-secondary-container text-on-secondary-container font-label-sm text-label-sm mb-3 font-semibold">
        <span class="material-symbols-outlined text-base">calculate</span>
        SIMULASI ANGSURAN RESMI FLPP
      </div>
      <h2 class="text-headline-lg-mobile md:text-headline-lg font-headline-lg text-primary mb-3">
        Transparansi Biaya: <br />Pilihan Tenor Angsuran Flat
      </h2>
      <p class="text-body-md text-on-surface-variant font-body-md">
        Harga Rumah Resmi: <strong class="text-on-surface">Rp 166.000.000</strong> | DP Ringan: <strong class="text-secondary">Rp 250.000</strong> | All-In: <strong class="text-primary font-bold">Rp 2 Juta Sampai Terima Kunci</strong> | Bunga FLPP: <strong class="text-on-surface">5% Flat</strong> hingga lunas.
      </p>
    </div>

    <!-- 3 Modern Pricing Cards -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 items-stretch max-w-5xl mx-auto">
      
      <!-- Card 1: 10 Tahun -->
      <div class="reveal delay-100 card-interactive bg-surface-container-lowest rounded-2xl p-6 border border-outline-variant shadow-sm flex flex-col justify-between">
        <div>
          <div class="mb-4">
            <span class="text-label-sm font-label-sm text-outline font-semibold">TENOR PENDEK</span>
            <h3 class="text-headline-sm font-headline-sm text-primary font-bold">10 Tahun</h3>
            <p class="text-body-sm font-body-sm text-on-surface-variant">Tempo Singkat Cepat Lunas</p>
          </div>
          <div class="my-6 p-4 rounded-xl bg-surface-container-low border border-outline-variant/50">
            <p class="text-label-sm font-label-sm text-outline">Angsuran Flat Tiap Bulan</p>
            <div class="flex items-baseline gap-1 mt-1">
              <span class="text-headline-lg font-headline-lg text-primary font-bold">Rp 1.730.400</span>
              <span class="text-body-sm font-body-sm text-outline">/bln</span>
            </div>
            <p class="text-body-sm font-body-sm text-secondary mt-1 font-semibold">Bunga subsidi 5% fix</p>
          </div>
          <ul class="space-y-3 text-body-sm font-body-sm text-on-surface-variant">
            <li class="flex items-center gap-2">
              <span class="material-symbols-outlined text-secondary text-base">check</span>
              <span>Sertifikat lunas lebih cepat</span>
            </li>
            <li class="flex items-center gap-2">
              <span class="material-symbols-outlined text-secondary text-base">check</span>
              <span>Akumulasi total bunga paling hemat</span>
            </li>
            <li class="flex items-center gap-2">
              <span class="material-symbols-outlined text-secondary text-base">check</span>
              <span>Cocok untuk usia produktif lanjut</span>
            </li>
          </ul>
        </div>
        <div class="mt-8">
          <a
            class="w-full inline-flex items-center justify-center gap-2 border-2 border-secondary text-secondary hover:bg-secondary-container/30 px-5 py-3 rounded-lg text-label-md font-label-md transition-colors text-center font-semibold"
            href={waTenor10}
            rel="noopener noreferrer"
            target="_blank"
          >
            Pilih Tenor 10 Tahun
          </a>
        </div>
      </div>

      <!-- Card 2: 15 Tahun -->
      <div class="reveal delay-200 card-interactive bg-surface-container-lowest rounded-2xl p-6 border border-outline-variant shadow-sm flex flex-col justify-between">
        <div>
          <div class="mb-4">
            <span class="text-label-sm font-label-sm text-outline font-semibold">TENOR MODERAT</span>
            <h3 class="text-headline-sm font-headline-sm text-primary font-bold">15 Tahun</h3>
            <p class="text-body-sm font-body-sm text-on-surface-variant">Pilihan Finansial Seimbang</p>
          </div>
          <div class="my-6 p-4 rounded-xl bg-surface-container-low border border-outline-variant/50">
            <p class="text-label-sm font-label-sm text-outline">Angsuran Flat Tiap Bulan</p>
            <div class="flex items-baseline gap-1 mt-1">
              <span class="text-headline-lg font-headline-lg text-primary font-bold">Rp 1.287.300</span>
              <span class="text-body-sm font-body-sm text-outline">/bln</span>
            </div>
            <p class="text-body-sm font-body-sm text-secondary mt-1 font-semibold">Bunga subsidi 5% fix</p>
          </div>
          <ul class="space-y-3 text-body-sm font-body-sm text-on-surface-variant">
            <li class="flex items-center gap-2">
              <span class="material-symbols-outlined text-secondary text-base">check</span>
              <span>Beban cashflow bulanan moderat</span>
            </li>
            <li class="flex items-center gap-2">
              <span class="material-symbols-outlined text-secondary text-base">check</span>
              <span>Ruang tabungan keluarga lebih aman</span>
            </li>
            <li class="flex items-center gap-2">
              <span class="material-symbols-outlined text-secondary text-base">check</span>
              <span>Bisa dilunasi sebagian di tengah jalan</span>
            </li>
          </ul>
        </div>
        <div class="mt-8">
          <a
            class="w-full inline-flex items-center justify-center gap-2 border-2 border-secondary text-secondary hover:bg-secondary-container/30 px-5 py-3 rounded-lg text-label-md font-label-md transition-colors text-center font-semibold active:scale-95"
            href={waTenor15}
            rel="noopener noreferrer"
            target="_blank"
          >
            Pilih Tenor 15 Tahun
          </a>
        </div>
      </div>

      <!-- Card 3: 20 Tahun (Featured / Rekomendasi) -->
      <div class="reveal delay-300 card-interactive bg-surface-container-lowest rounded-2xl p-6 border-2 border-secondary shadow-xl flex flex-col justify-between relative md:-translate-y-2">
        <!-- Badge Rekomendasi -->
        <div class="absolute -top-3.5 left-1/2 -translate-x-1/2 bg-secondary text-on-secondary text-label-sm font-label-sm px-4 py-1 rounded-full shadow-sm font-bold tracking-wide">
          REKOMENDASI TERBAIK
        </div>
        <div>
          <div class="mb-4 pt-2">
            <span class="text-label-sm font-label-sm text-secondary font-semibold">ANGSURAN PALING RINGAN</span>
            <h3 class="text-headline-sm font-headline-sm text-primary font-bold">20 Tahun</h3>
            <p class="text-body-sm font-body-sm text-on-surface-variant">Setara ~Rp 35.700 per hari</p>
          </div>
          <div class="my-6 p-4 rounded-xl bg-secondary-container/20 border border-secondary/40">
            <p class="text-label-sm font-label-sm text-secondary font-medium">Angsuran Flat Tiap Bulan</p>
            <div class="flex items-baseline gap-1 mt-1">
              <span class="text-headline-lg font-headline-lg text-primary font-black">Rp 1.072.300</span>
              <span class="text-body-sm font-body-sm text-outline">/bln</span>
            </div>
            <p class="text-body-sm font-body-sm text-secondary mt-1 font-semibold">Paling diminati pembeli pertama</p>
          </div>
          <ul class="space-y-3 text-body-sm font-body-sm text-on-surface-variant">
            <li class="flex items-center gap-2">
              <span class="material-symbols-outlined text-secondary text-base" data-weight="fill">check_circle</span>
              <span>Sama persis dengan uang sewa kontrakan</span>
            </li>
            <li class="flex items-center gap-2">
              <span class="material-symbols-outlined text-secondary text-base" data-weight="fill">check_circle</span>
              <span>Cicilan tidak pernah naik hingga lunas</span>
            </li>
            <li class="flex items-center gap-2">
              <span class="material-symbols-outlined text-secondary text-base" data-weight="fill">check_circle</span>
              <span>Karyawan maupun wiraswasta mudah lolos verifikasi bank</span>
            </li>
          </ul>
        </div>
        <div class="mt-8">
          <a
            class="w-full inline-flex items-center justify-center gap-2 bg-secondary text-on-secondary hover:bg-primary-container px-5 py-3.5 rounded-lg text-label-md font-label-md transition-all duration-150 active:scale-95 shadow-sm text-center font-semibold"
            href={waTenor20}
            rel="noopener noreferrer"
            target="_blank"
          >
            <span>Pilih Tenor 20 Th via WhatsApp</span>
            <span class="material-symbols-outlined text-base">arrow_forward</span>
          </a>
        </div>
      </div>

    </div>

    <p class="text-center text-body-sm font-body-sm text-outline mt-10">
      Cicilan Flat Sampai Lunas · Bekerja Sama dengan Bank BNI & Bank BSN (BSI)
    </p>

  </div>
</section>
