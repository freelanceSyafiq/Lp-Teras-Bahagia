---
const waTenor10 = "https://wa.me/6281517258271?text=Halo%20Teras%20Bahagia,%20saya%20tertarik%20simulasi%20tenor%2010%20tahun%20(Rp%201.730.400)";
const waTenor15 = "https://wa.me/6281517258271?text=Halo%20Teras%20Bahagia,%20saya%20tertarik%20simulasi%20tenor%2015%20tahun%20(Rp%201.287.300)";
const waTenor20 = "https://wa.me/6281517258271?text=Halo%20Teras%20Bahagia,%20saya%20ingin%20ambil%20tenor%2020%20tahun%20Rp%201.072.300";
---

<section class="bg-surface-container-low py-20 border-b border-outline-variant/40" id="simulasi-cicilan">
  <div class="max-w-7xl mx-auto px-4 md:px-8">
    
    <!-- Section Header -->
    <div class="reveal text-center max-w-3xl mx-auto mb-14">
      <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-secondary-container text-on-secondary-container font-label-sm text-label-sm mb-3 font-semibold">
        <span class="material-symbols-outlined text-base">calculate</span>
        SIMULASI ANGSURAN RESMI FLPP
      </div>
      <h2 class="text-headline-lg-mobile md:text-headline-lg font-headline-lg text-primary mb-3">
        Transparansi Biaya: <br />Pilihan Tenor Angsuran Flat
      </h2>
      <p class="text-body-md text-on-surface-variant font-body-md">
        Harga Rumah Resmi: <strong class="text-on-surface">Rp 166.000.000</strong> | DP Ringan: <strong class="text-secondary">Rp 250.000</strong> | All-In: <strong class="text-primary font-bold">Rp 2 Juta Sampai Terima Kunci</strong> | Bunga FLPP: <strong class="text-on-surface">5% Flat</strong> hingga lunas.
      </p>
    </div>

    <!-- 3 Modern Pricing Cards -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 items-stretch max-w-5xl mx-auto">
      
      <!-- Card 1: 10 Tahun (Angsuran Cepat) -->
      <div class="reveal delay-100 pricing-card bg-surface-container-lowest rounded-2xl p-6 border-2 border-outline-variant/50 shadow-sm flex flex-col justify-between cursor-pointer">
        <div>
          <div class="mb-4">
            <span class="text-label-sm font-label-sm text-red-600 font-bold tracking-wide">ANGSURAN CEPAT</span>
            <h3 class="text-headline-sm font-headline-sm text-primary font-bold">10 Tahun</h3>
            <p class="text-body-sm font-body-sm text-on-surface-variant">Tempo Singkat Cepat Lunas</p>
          </div>
          <div class="pricing-box my-6 p-4 rounded-xl bg-surface-container-low border border-outline-variant/50">
            <p class="pricing-box-label text-label-sm font-label-sm text-outline">Angsuran Flat Tiap Bulan</p>
            <div class="flex items-baseline gap-1 mt-1">
              <span class="text-headline-lg font-headline-lg text-primary font-bold">Rp 1.730.400</span>
              <span class="text-body-sm font-body-sm text-outline">/bln</span>
            </div>
            <p class="text-body-sm font-body-sm text-secondary mt-1 font-semibold">Bunga subsidi 5% fix</p>
          </div>
          <ul class="space-y-3 text-body-sm font-body-sm text-on-surface-variant">
            <li class="flex items-center gap-2">
              <span class="material-symbols-outlined text-secondary text-base">check_circle</span>
              <span>Sertifikat lunas lebih cepat</span>
            </li>
            <li class="flex items-center gap-2">
              <span class="material-symbols-outlined text-secondary text-base">check_circle</span>
              <span>Akumulasi total bunga paling hemat</span>
            </li>
            <li class="flex items-center gap-2">
              <span class="material-symbols-outlined text-secondary text-base">check_circle</span>
              <span>Cocok untuk usia produktif lanjut</span>
            </li>
          </ul>
        </div>
        <div class="mt-8">
          <a
            class="pricing-btn w-full inline-flex items-center justify-center gap-2 px-5 py-3.5 rounded-lg text-label-md font-label-md text-center font-semibold active:scale-95 shadow-xs"
            href={waTenor10}
            rel="noopener noreferrer"
            target="_blank"
          >
            <span>Pilih Tenor 10 Tahun</span>
            <span class="material-symbols-outlined text-base">arrow_forward</span>
          </a>
        </div>
      </div>

      <!-- Card 2: 15 Tahun (Angsuran Moderat) -->
      <div class="reveal delay-200 pricing-card bg-surface-container-lowest rounded-2xl p-6 border-2 border-outline-variant/50 shadow-sm flex flex-col justify-between cursor-pointer">
        <div>
          <div class="mb-4">
            <span class="text-label-sm font-label-sm text-blue-600 font-bold tracking-wide">ANGSURAN MODERAT</span>
            <h3 class="text-headline-sm font-headline-sm text-primary font-bold">15 Tahun</h3>
            <p class="text-body-sm font-body-sm text-on-surface-variant">Pilihan Finansial Seimbang</p>
          </div>
          <div class="pricing-box my-6 p-4 rounded-xl bg-surface-container-low border border-outline-variant/50">
            <p class="pricing-box-label text-label-sm font-label-sm text-outline">Angsuran Flat Tiap Bulan</p>
            <div class="flex items-baseline gap-1 mt-1">
              <span class="text-headline-lg font-headline-lg text-primary font-bold">Rp 1.287.300</span>
              <span class="text-body-sm font-body-sm text-outline">/bln</span>
            </div>
            <p class="text-body-sm font-body-sm text-secondary mt-1 font-semibold">Bunga subsidi 5% fix</p>
          </div>
          <ul class="space-y-3 text-body-sm font-body-sm text-on-surface-variant">
            <li class="flex items-center gap-2">
              <span class="material-symbols-outlined text-secondary text-base">check_circle</span>
              <span>Beban cashflow bulanan moderat</span>
            </li>
            <li class="flex items-center gap-2">
              <span class="material-symbols-outlined text-secondary text-base">check_circle</span>
              <span>Ruang tabungan keluarga lebih aman</span>
            </li>
            <li class="flex items-center gap-2">
              <span class="material-symbols-outlined text-secondary text-base">check_circle</span>
              <span>Bisa dilunasi sebagian di tengah jalan</span>
            </li>
          </ul>
        </div>
        <div class="mt-8">
          <a
            class="pricing-btn w-full inline-flex items-center justify-center gap-2 px-5 py-3.5 rounded-lg text-label-md font-label-md text-center font-semibold active:scale-95 shadow-xs"
            href={waTenor15}
            rel="noopener noreferrer"
            target="_blank"
          >
            <span>Pilih Tenor 15 Tahun</span>
            <span class="material-symbols-outlined text-base">arrow_forward</span>
          </a>
        </div>
      </div>

      <!-- Card 3: 20 Tahun (Angsuran Ringan) -->
      <div class="reveal delay-300 pricing-card bg-surface-container-lowest rounded-2xl p-6 border-2 border-outline-variant/50 shadow-sm flex flex-col justify-between cursor-pointer">
        <div>
          <div class="mb-4">
            <span class="text-label-sm font-label-sm text-secondary font-bold tracking-wide">ANGSURAN RINGAN</span>
            <h3 class="text-headline-sm font-headline-sm text-primary font-bold">20 Tahun</h3>
            <p class="text-body-sm font-body-sm text-on-surface-variant">Setara ~Rp 35.700 per hari</p>
          </div>
          <div class="pricing-box my-6 p-4 rounded-xl bg-surface-container-low border border-outline-variant/50">
            <p class="pricing-box-label text-label-sm font-label-sm text-outline">Angsuran Flat Tiap Bulan</p>
            <div class="flex items-baseline gap-1 mt-1">
              <span class="text-headline-lg font-headline-lg text-primary font-bold">Rp 1.072.300</span>
              <span class="text-body-sm font-body-sm text-outline">/bln</span>
            </div>
            <p class="text-body-sm font-body-sm text-secondary mt-1 font-semibold">Paling diminati pembeli pertama</p>
          </div>
          <ul class="space-y-3 text-body-sm font-body-sm text-on-surface-variant">
            <li class="flex items-center gap-2">
              <span class="material-symbols-outlined text-secondary text-base">check_circle</span>
              <span>Sama persis dengan uang sewa kontrakan</span>
            </li>
            <li class="flex items-center gap-2">
              <span class="material-symbols-outlined text-secondary text-base">check_circle</span>
              <span>Cicilan tidak pernah naik hingga lunas</span>
            </li>
            <li class="flex items-center gap-2">
              <span class="material-symbols-outlined text-secondary text-base">check_circle</span>
              <span>Karyawan maupun wiraswasta mudah lolos verifikasi bank</span>
            </li>
          </ul>
        </div>
        <div class="mt-8">
          <a
            class="pricing-btn w-full inline-flex items-center justify-center gap-2 px-5 py-3.5 rounded-lg text-label-md font-label-md text-center font-semibold active:scale-95 shadow-xs"
            href={waTenor20}
            rel="noopener noreferrer"
            target="_blank"
          >
            <span>Pilih Tenor 20 Tahun</span>
            <span class="material-symbols-outlined text-base">arrow_forward</span>
          </a>
        </div>
      </div>

    </div>

    <!-- Card Jaminan Flat & Bank Rekanan (Card Berwarna Hijau) -->
    <div class="reveal delay-300 max-w-4xl mx-auto mt-12 bg-linear-to-r from-primary via-primary-container to-secondary rounded-2xl p-6 sm:p-7 shadow-lg border border-secondary-fixed/20 text-on-primary">
      <div class="flex flex-col md:flex-row items-center justify-between gap-5 text-center md:text-left">
        <div class="flex flex-col sm:flex-row items-center gap-4">
          <div class="w-12 h-12 rounded-2xl bg-white/10 backdrop-blur-md border border-white/20 flex items-center justify-center shrink-0 text-secondary-fixed shadow-inner">
            <span class="material-symbols-outlined text-3xl">verified_user</span>
          </div>
          <div>
            <div class="inline-flex items-center gap-2 px-3 py-0.5 rounded-full bg-secondary-container/20 border border-secondary-container/40 text-secondary-fixed text-xs font-bold mb-1.5">
              <span class="w-2 h-2 rounded-full bg-secondary-fixed pulse-indicator"></span>
              Jaminan Kepastian Finansial FLPP Resmi
            </div>
            <h4 class="text-headline-sm font-headline-sm font-bold text-white tracking-tight">
              Cicilan Flat Sampai Lunas
            </h4>
            <p class="text-body-sm font-body-sm text-primary-fixed-dim mt-0.5">
              Bekerja Sama Resmi dengan <strong class="text-white font-semibold">Bank BNI</strong> & <strong class="text-white font-semibold">Bank BSN</strong>
            </p>
          </div>
        </div>

        <div class="flex flex-wrap items-center justify-center gap-2.5 shrink-0">
          <div class="px-4 py-2 rounded-xl bg-white/10 backdrop-blur-md border border-white/15 text-xs font-bold text-white tracking-wider flex items-center gap-2 shadow-xs">
            <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
            BANK BNI
          </div>
          <div class="px-4 py-2 rounded-xl bg-white/10 backdrop-blur-md border border-white/15 text-xs font-bold text-white tracking-wider flex items-center gap-2 shadow-xs">
            <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
            BANK BSN
          </div>
        </div>
      </div>
    </div>

  </div>
</section>
