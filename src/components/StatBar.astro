---
const stats = [
  { value: '±10 ha', label: 'Luas kawasan mandiri' },
  { value: '80+ unit', label: 'Terjual di Tahap 1 & 2' },
  { value: '72 m²', label: 'Tanah per unit, terbesar di kelasnya' },
  { value: '5% flat', label: 'Bunga KPR subsidi pemerintah' },
];
---

<section aria-label="Fakta singkat" class="border-y border-slate-200 bg-white">
  <dl class="mx-auto grid max-w-6xl grid-cols-2 px-5 md:grid-cols-4">
    {stats.map((s, i) => (
      <div
        class:list={[
          'flex flex-col-reverse py-6 md:py-8',
          i % 2 === 1 && 'border-l border-slate-200 pl-5',
          i >= 2 && 'border-t border-slate-200 md:border-t-0',
          i > 0 && 'md:border-l md:border-slate-200 md:pl-6',
        ]}
      >
        <dt class="mt-1 text-sm text-slate-600">{s.label}</dt>
        <dd class="font-display text-3xl tracking-tight md:text-4xl">{s.value}</dd>
      </div>
    ))}
  </dl>
</section>
