---
// Editorial section header: hairline rule, index number, left-aligned title.
interface Props {
  index: string;
  label: string;
  tone?: 'light' | 'dark';
}
const { index, label, tone = 'light' } = Astro.props;
const dark = tone === 'dark';
---

<div
  class:list={[
    'grid gap-4 border-t pt-5 md:grid-cols-[200px_1fr] md:gap-10',
    dark ? 'border-slate-600' : 'border-slate-900',
  ]}
>
  <p class:list={['text-sm font-semibold', dark ? 'text-slate-300' : 'text-slate-900']}>
    <span class:list={['tabular-nums', dark ? 'text-amber-400' : 'text-emerald-700']}>{index}</span>
    <span class="mx-1.5 text-slate-400">/</span>{label}
  </p>
  <div class="max-w-3xl">
    <slot />
  </div>
</div>
